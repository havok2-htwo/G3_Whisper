# Copy this file to `.env` (docker compose loads it automatically) and fill in the values.

# ---------------------------------------------------------------------------
# Hugging Face token — used by both containers for gated models:
#   WHISPER : CohereLabs/cohere-transcribe-03-2026 (default ASR model)
#             accept the license at https://huggingface.co/CohereLabs/cohere-transcribe-03-2026
#   OmniVoice: higher HF rate limits / any gated snapshot
# Create at https://huggingface.co/settings/tokens and ACCEPT each model's license.
# The Whisper ASR path accepts HUGGINGFACE_TOKEN/HF_TOKEN. ReDimNet2 is loaded
# from its public, SHA256-verified GitHub release and needs no Hugging Face token.
#
# Diarization (runs inside Whisper) reads the pyannote segmentation-3.0 checkpoint
# (the `segmentation` folder of the gated pyannote/speaker-diarization-community-1, or
# pyannote/segmentation-3.0) from Whisper's Hugging Face cache. It is NEVER downloaded
# automatically: accept the license and put the snapshot into the cache, or set
# `segmentation_model_path` in the admin UI. Without it diarization answers 503.
# (The old DIA_SERVER_BASE_URL / DIA_SERVER_API_KEY variables are ignored.)
# ---------------------------------------------------------------------------
HUGGINGFACE_TOKEN=
HF_TOKEN=

# ---------------------------------------------------------------------------
# Admin login
# ---------------------------------------------------------------------------
# There are NO admin keys anymore. Each admin dashboard (/admin on 7861 / 8091)
# is protected by a username/password login. The default account on a fresh deploy is
#   admin / admin
# and you are FORCED to change the password on first login. Credentials/sessions are
# stored per service in its own volume, so there is nothing to configure here.
