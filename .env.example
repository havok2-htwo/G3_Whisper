# Copy this file to `.env` (docker compose loads it automatically) and fill in the values.
# Leave a value empty to keep the built-in default.

# ---------------------------------------------------------------------------
# Hugging Face token — used by BOTH containers.
#   WHISPER needs it for the gated models:
#     - pyannote/speaker-diarization-community-1  (speaker diarization)
#     - pyannote/embedding                        (voice-id)
#     - CohereLabs/cohere-transcribe-03-2026      (Cohere backend, optional)
#   OmniVoice uses it for higher HF rate limits / any gated snapshot.
# Create at https://huggingface.co/settings/tokens and ACCEPT each model's license.
# IMPORTANT: set HUGGINGFACE_TOKEN — the Whisper diarization engine reads that name
# specifically. The ASR / voice-id paths also accept HF_TOKEN as an alias; set both to
# the same value so every code path is covered.
# ---------------------------------------------------------------------------
HUGGINGFACE_TOKEN=
HF_TOKEN=

# ---------------------------------------------------------------------------
# WHISPER admin (dashboard at /admin, header X-Admin-Key)
# ---------------------------------------------------------------------------
# Persistent bootstrap admin key. If empty, a random one is generated per boot and
# only recoverable via the temporary startup key below.
GENESIS_ADMIN_KEY=
# Optional short-lived emergency key printed at startup (empty = disabled).
GENESIS_STARTUP_ADMIN_KEY=

# ---------------------------------------------------------------------------
# OmniVoice admin (header X-Admin-Key / admin API + dashboard at /admin)
# ---------------------------------------------------------------------------
# Set a STRONG secret to enable the admin API (e.g. `openssl rand -hex 32`).
# Leave EMPTY to fail closed: a random key is generated per boot but is NOT logged
# anywhere, so the admin API stays locked until you set your own key here — or use the
# short-lived startup key below to rotate one in from the dashboard.
# (Do NOT ship a fixed placeholder here: any non-empty value becomes the real, now
#  publicly-known admin key.)
OMNIVOICE_TTS_ADMIN_API_KEY=
# Optional temporary startup key (TTL OMNIVOICE_TTS_STARTUP_ADMIN_KEY_TTL_SECONDS, default 300s).
OMNIVOICE_TTS_STARTUP_ADMIN_KEY=
