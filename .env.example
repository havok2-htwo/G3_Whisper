# Copy this file to `.env` (docker compose loads it automatically) and fill in the values.

# ---------------------------------------------------------------------------
# Hugging Face token — used by all three containers for gated models:
#   WHISPER : pyannote/speaker-diarization-community-1, pyannote/embedding,
#             CohereLabs/cohere-transcribe-03-2026 (optional)
#   DIA     : pyannote/speaker-diarization-community-1
#   OmniVoice: higher HF rate limits / any gated snapshot
# Create at https://huggingface.co/settings/tokens and ACCEPT each model's license.
# WHISPER's diarization engine reads HUGGINGFACE_TOKEN specifically; the ASR / voice-id
# paths also accept HF_TOKEN. Set both to the same value so every code path is covered.
# ---------------------------------------------------------------------------
HUGGINGFACE_TOKEN=
HF_TOKEN=

# ---------------------------------------------------------------------------
# Admin login
# ---------------------------------------------------------------------------
# There are NO admin keys anymore. Each admin dashboard (/admin on 7861 / 8091 / 7864)
# is protected by a username/password login. The default account on a fresh deploy is
#   admin / admin
# and you are FORCED to change the password on first login. Credentials/sessions are
# stored per service in its own volume, so there is nothing to configure here.
